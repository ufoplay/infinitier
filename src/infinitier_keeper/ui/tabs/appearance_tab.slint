// The Appearance tab: the colour swatches, each opening a grid of the game's
// gradients to pick from; and, to their right, the character's paperdoll and
// its two portraits, each over a dropdown to pick it by name (the doll's picks
// the animation). In a ScrollArea like the card tabs:
// the fixed-width swatch rows would otherwise cap the panel's (and so the
// window's) width.

import {
    Card, Checkbox, Label, Popover, ScrollArea, Select, StateLayer, TextRole, Theme, Tone,
} from "@themekit";
import { Metrics } from "../themes/metrics.slint";

// One labelled colour slot: the gradient it's set to, pre-rendered as a
// swatch.
export struct ColorSwatch {
    label: string,
    index: int,
    image: image,
}

export global AppearanceAdapter {
    // The animations to pick from, by name, and the creature's.
    in property <[string]> animations;
    in property <int> animation-index;
    in property <[ColorSwatch]> swatches;
    // Every gradient a colour can pick, as a swatch, in colour order; empty
    // when the game has none, and then the colours can't be picked.
    in property <[image]> palette;
    // Empty when this character's animation has no paperdoll: its card then
    // says so.
    in property <image> doll;
    // Whether the doll has equipment to show or hide, and whether it shows it.
    in property <bool> doll-has-equipment;
    in property <bool> show-equipment;
    // The small and the large portrait: the game's pictures to pick each
    // from, by name, the character's, and its picture (empty when the game
    // has none by that name).
    in property <[string]> small-portraits;
    in property <int> small-portrait-index;
    in property <image> small-portrait;
    in property <[string]> large-portraits;
    in property <int> large-portrait-index;
    in property <image> large-portrait;
    callback select-animation(index: int);
    callback select-small-portrait(index: int);
    callback select-large-portrait(index: int);
    // Set the colour of swatch row `slot` to gradient `gradient`.
    callback pick-color(slot: int, gradient: int);
    callback toggle-equipment();
}

// A grid of every gradient to pick colour `swatch` from, the current one
// ringed. Picking one reports `picked(gradient)`.
component Palette inherits Rectangle {
    in property <ColorSwatch> swatch;
    callback picked(gradient: int);

    property <length> gap: Theme.spacing.xs;
    property <length> pitch: Metrics.palette-swatch-size + self.gap;
    // The gradient under the pointer, -1 for none.
    property <int> hovered: -1;

    VerticalLayout {
        spacing: Theme.spacing.sm;
        Label { text: root.swatch.label; role: TextRole.heading; }
        Label {
            text: "Colour " + (root.hovered >= 0 ? root.hovered : root.swatch.index);
            role: TextRole.caption;
            tone: Tone.muted;
        }
        Rectangle {
            width: Metrics.palette-columns * root.pitch - root.gap;
            height: ceil(AppearanceAdapter.palette.length / Metrics.palette-columns) * root.pitch - root.gap;
            for shade[gradient] in AppearanceAdapter.palette: Rectangle {
                x: mod(gradient, Metrics.palette-columns) * root.pitch;
                y: floor(gradient / Metrics.palette-columns) * root.pitch;
                width: Metrics.palette-swatch-size;
                height: Metrics.palette-swatch-size;
                accessible-role: button;
                accessible-label: "Colour " + gradient;
                accessible-action-default => { root.picked(gradient); }

                Image {
                    source: shade;
                    width: parent.width;
                    height: parent.height;
                    image-rendering: pixelated;
                }
                StateLayer {
                    hovered: cell.has-hover;
                    pressed: cell.pressed;
                }
                // Around the swatch, in the gap, so it hides none of it.
                if gradient == root.swatch.index: Rectangle {
                    x: -Theme.sizes.focus-width;
                    y: -Theme.sizes.focus-width;
                    width: parent.width + Theme.sizes.focus-width * 2;
                    height: parent.height + Theme.sizes.focus-width * 2;
                    border-width: Theme.sizes.focus-width;
                    border-color: Theme.palette.primary;
                }
                cell := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(gradient); }
                    changed has-hover => {
                        if self.has-hover {
                            root.hovered = gradient;
                        } else if root.hovered == gradient {
                            root.hovered = -1;
                        }
                    }
                }
            }
        }
    }
}

// Colour `swatch`, a button that opens the grid to pick another from (a
// popup can't sit in a repeated row itself). Picking one reports
// `picked(gradient)`.
component SwatchButton inherits Rectangle {
    in property <ColorSwatch> swatch;
    callback picked(gradient: int);

    property <bool> enabled: AppearanceAdapter.palette.length > 0;

    width: Metrics.swatch-size;
    height: Metrics.swatch-size;
    accessible-role: button;
    accessible-label: root.swatch.label;
    accessible-value: "Colour " + root.swatch.index;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            picker.show();
        }
    }

    Image {
        source: root.swatch.image;
        width: parent.width;
        height: parent.height;
        image-rendering: pixelated;
    }
    StateLayer {
        hovered: touch.has-hover;
        pressed: touch.pressed;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { picker.show(); }
    }
    // To the swatch's right, its top level with it.
    picker := Popover {
        x: root.width + Theme.spacing.sm;
        y: 0;
        Palette {
            swatch: root.swatch;
            picked(gradient) => {
                picker.close();
                root.picked(gradient);
            }
        }
    }
}

// One of the character's portraits: the picture in a fixed box, so that the
// card keeps its size from one character to the next, over the dropdown to
// pick it from the game's pictures. Every portrait's box is as tall, which
// lines their dropdowns up. Picking one reports `selected(index)`.
component PortraitPicker inherits VerticalLayout {
    in property <string> label;
    in property <[string]> names;
    in property <int> current-index;
    in property <image> picture;
    in property <length> box-width;
    callback selected(index: int);

    alignment: start;
    spacing: Theme.spacing.sm;
    Label { text: root.label; role: TextRole.caption; tone: Tone.muted; }
    // A picture larger than the box shrinks to fit it; a smaller one (the
    // original games' are) keeps its size, which shows how the two compare,
    // and isn't blurred. Its top is the box's, level with the other's.
    Rectangle {
        width: root.box-width;
        height: Metrics.appearance-portrait-height;
        if root.picture.width == 0: Label {
            width: parent.width;
            text: "Image not available";
            tone: Tone.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.picture.width > 0: Image {
            property <float> scale: min(1,
                parent.width / (self.source.width * Metrics.appearance-art-pixel),
                parent.height / (self.source.height * Metrics.appearance-art-pixel));
            y: 0;
            source: root.picture;
            width: self.source.width * self.scale * Metrics.appearance-art-pixel;
            height: self.source.height * self.scale * Metrics.appearance-art-pixel;
        }
    }
    Select {
        width: root.box-width;
        options: root.names;
        current-index: root.current-index;
        selected(index) => { root.selected(index); }
    }
}

export component AppearanceTab inherits ScrollArea {
    content-spacing: Theme.spacing.sm;
    HorizontalLayout {
        alignment: start;
        spacing: Theme.spacing.md;
        // The cards share a height: the shorter one's spare room goes below
        // its content, not into its heading.
        Card {
            VerticalLayout {
                alignment: start;
                spacing: Theme.spacing.sm;
                Label { text: "Colors"; role: TextRole.heading; }
                for swatch[slot] in AppearanceAdapter.swatches: HorizontalLayout {
                    spacing: Theme.spacing.md;
                    Label { text: swatch.label; width: Metrics.appearance-label-width; }
                    SwatchButton {
                        swatch: swatch;
                        picked(gradient) => { AppearanceAdapter.pick-color(slot, gradient); }
                    }
                }
            }
        }
        Card {
            VerticalLayout {
                alignment: start;
                spacing: Theme.spacing.sm;
                Label { text: "Character"; role: TextRole.heading; }
                // A fixed box: the cards don't move from one character to the
                // next, whose images differ in size, nor when one has none.
                // Whole multiples of the art's pixels keep it crisp; the
                // largest that fits fills the box in every game, whose art
                // ranges from small to large.
                Rectangle {
                    width: Metrics.appearance-doll-width;
                    height: Metrics.appearance-doll-height;
                    if AppearanceAdapter.doll.width == 0: Label {
                        text: "Image not available";
                        tone: Tone.muted;
                        horizontal-alignment: center;
                    }
                    if AppearanceAdapter.doll.width > 0: Image {
                        property <float> scale: max(1, floor(min(
                            parent.width / (self.source.width * Metrics.appearance-art-pixel),
                            parent.height / (self.source.height * Metrics.appearance-art-pixel))));
                        source: AppearanceAdapter.doll;
                        width: self.source.width * self.scale * Metrics.appearance-art-pixel;
                        height: self.source.height * self.scale * Metrics.appearance-art-pixel;
                        image-rendering: pixelated;
                    }
                }
                // The animation, by name: the doll above is its art.
                Select {
                    width: Metrics.appearance-doll-width;
                    accessible-label: "Appearance";
                    options: AppearanceAdapter.animations;
                    current-index: AppearanceAdapter.animation-index;
                    selected(index) => { AppearanceAdapter.select-animation(index); }
                }
                if AppearanceAdapter.doll-has-equipment: Checkbox {
                    text: "Show equipment";
                    checked: AppearanceAdapter.show-equipment;
                    toggled => {
                        AppearanceAdapter.toggle-equipment();
                    }
                }
            }
        }
        Card {
            VerticalLayout {
                alignment: start;
                spacing: Theme.spacing.sm;
                Label { text: "Portraits"; role: TextRole.heading; }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.spacing.md;
                    PortraitPicker {
                        label: "Large";
                        names: AppearanceAdapter.large-portraits;
                        current-index: AppearanceAdapter.large-portrait-index;
                        picture: AppearanceAdapter.large-portrait;
                        box-width: Metrics.appearance-portrait-width;
                        selected(index) => { AppearanceAdapter.select-large-portrait(index); }
                    }
                    PortraitPicker {
                        label: "Small";
                        names: AppearanceAdapter.small-portraits;
                        current-index: AppearanceAdapter.small-portrait-index;
                        picture: AppearanceAdapter.small-portrait;
                        box-width: Metrics.appearance-small-portrait-width;
                        selected(index) => { AppearanceAdapter.select-small-portrait(index); }
                    }
                }
            }
        }
    }
}
