// The Inventory tab: one row per slot — icon, position, editable quantities,
// item name, resref and Delete. Clicking a slot selects it as the Item
// Browser's add target; double-clicking a filled one reveals its item there.

import { ControlSize, Label, Table, TableCell, Theme, Tone } from "@themekit";
import { BrowserKind, BrowsersAdapter } from "../browser/browser.slint";
import { Metrics } from "../themes/metrics.slint";

export global InventoryAdapter {
    // One row per slot, in slot order: icon, position, the three quantities
    // / charges (a `u16` each), item name, resref and Delete. An empty slot
    // has no quantities and no Delete.
    in property <[[TableCell]]> rows;
    // Each slot's item resref, "" for an empty slot.
    in property <[string]> resrefs;
    // The selected slot, -1 for none. Set here on click, so the rows aren't
    // rebuilt (which would drop the slot's double-click).
    in-out property <int> selected: -1;
    callback select(int /* slot */);
    callback quantity(int /* slot */, int /* which, 0..2 */, string /* value */);
    callback delete(int /* slot */);
}

export component InventoryTab inherits VerticalLayout {
    // A creature format without an inventory has no slots at all.
    if InventoryAdapter.rows.length == 0: Label {
        text: "Inventory is unavailable for this creature's format.";
        tone: Tone.muted;
        vertical-stretch: 1;
        vertical-alignment: top;
    }
    if InventoryAdapter.rows.length > 0: Table {
        columns: [
            { width: Metrics.inventory-icon },
            { title: "Position", width: Metrics.inventory-position-column },
            { title: "Qty 1", width: Metrics.quantity-width },
            { title: "Qty 2", width: Metrics.quantity-width },
            { title: "Qty 3", width: Metrics.quantity-width },
            { title: "Item" },
            { title: "Resource", width: Metrics.inventory-resource-column },
            { width: Theme.control-height(ControlSize.small) },
        ];
        rows: InventoryAdapter.rows;
        size: ControlSize.small;
        selected-row: InventoryAdapter.selected;
        row-clicked(slot) => {
            InventoryAdapter.selected = slot;
            InventoryAdapter.select(slot);
        }
        row-double-clicked(slot) => {
            if (InventoryAdapter.resrefs[slot] != "") {
                BrowsersAdapter.front = BrowserKind.items;
                BrowsersAdapter.reveal(BrowserKind.items, InventoryAdapter.resrefs[slot]);
            }
        }
        // The quantities are columns 2 to 4.
        number-changed(slot, column, value) => { InventoryAdapter.quantity(slot, column - 2, value); }
        button-clicked(slot) => { InventoryAdapter.delete(slot); }
    }
}
