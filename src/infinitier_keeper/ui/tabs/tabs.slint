// The character tabs' pages. The fifteen tabs share seven layouts: the card
// grid serves the six stat tabs, the editable table Memorization and
// Proficiencies, the table both variable tabs, the grid Effects and Journal
// Entries; Appearance, Inventory and Spells have their own. Each page reads
// its adapter global, which the Rust side fills.

export { CardsTab, CardsAdapter } from "cards_tab.slint";
export { TableTab, TableAdapter } from "table_tab.slint";
export { EditTableTab, EditTableAdapter } from "edit_table_tab.slint";
export { GridTab, GridAdapter } from "grid_tab.slint";
export { AppearanceTab, AppearanceAdapter, ColorSwatch } from "appearance_tab.slint";
export { InventoryTab, InventoryAdapter } from "inventory_tab.slint";
export { SpellsTab, SpellsAdapter } from "spells_tab.slint";
