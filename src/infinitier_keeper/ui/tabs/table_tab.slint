// The Local / Global Variables tabs: a read-only Name · Value table.

import { Table, TableCell } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

export global TableAdapter {
    // Each variable's name and value.
    in property <[[TableCell]]> rows;
}

export component TableTab inherits Table {
    columns: [
        { title: "Name", width: Metrics.variable-name-width },
        { title: "Value" },
    ];
    rows: TableAdapter.rows;
}
