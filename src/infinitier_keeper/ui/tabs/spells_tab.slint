// The Spells tab: a strip of spellbooks (AD&D Innate / Wizard / Cleric, or
// IWD2's per-class books) and the selected book's spells — Level,
// Memorized (editable), Spell, Resource, Delete. Double-clicking a row
// reveals its spell in the Spell Browser.

import { ControlSize, Label, Tab, TabBar, Table, TableCell, Theme } from "@themekit";
import { BrowserKind, BrowsersAdapter } from "../browser/browser.slint";
import { Metrics } from "../themes/metrics.slint";

export global SpellsAdapter {
    // The spellbooks, with their spell counts.
    in property <[string]> books;
    in property <int> book;
    // The book's spells: level, memorized count (0 to 99), name, resref and
    // Delete.
    in property <[[TableCell]]> rows;
    // Each spell's resref.
    in property <[string]> resrefs;
    callback select-book(int);
    callback memorize(int /* row */, string /* value */);
    callback delete(int /* row */);
}

export component SpellsTab inherits VerticalLayout {
    spacing: Theme.spacing.sm;
    TabBar {
        for name[i] in SpellsAdapter.books: Tab {
            text: name;
            selected: i == SpellsAdapter.book;
            clicked => { SpellsAdapter.select-book(i); }
        }
    }
    if SpellsAdapter.rows.length == 0: Label {
        text: "No spells of this type.";
        font-weight: Theme.typography.strong-weight;
        vertical-stretch: 1;
        vertical-alignment: top;
    }
    if SpellsAdapter.rows.length > 0: Table {
        columns: [
            { title: "Level", width: Metrics.spell-level-column },
            { title: "Memorized", width: Metrics.spell-memorized-column },
            { title: "Spell" },
            { title: "Resource", width: Metrics.spell-resource-column },
            { width: Theme.control-height(ControlSize.small) },
        ];
        rows: SpellsAdapter.rows;
        size: ControlSize.small;
        row-double-clicked(row) => {
            BrowsersAdapter.front = BrowserKind.spells;
            BrowsersAdapter.reveal(BrowserKind.spells, SpellsAdapter.resrefs[row]);
        }
        number-changed(row, column, value) => { SpellsAdapter.memorize(row, value); }
        button-clicked(row) => { SpellsAdapter.delete(row); }
    }
}
