// The Memorization / Proficiencies tabs: a short table. Its first column
// names each row; the other columns hold numbers, some of them editable
// (drag or type, each change committed at once).

import { ControlSize, Table, TableCell, TableColumn } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

export global EditTableAdapter {
    in property <[TableColumn]> columns;
    in property <[[TableCell]]> rows;
    callback commit(int /* row */, int /* column */, string /* value */);
}

export component EditTableTab inherits HorizontalLayout {
    Table {
        // Not stretched across the whole tab: it grows up to its widest, and
        // the filler after it takes the rest.
        max-width: Metrics.edit-table-width;
        columns: EditTableAdapter.columns;
        rows: EditTableAdapter.rows;
        size: ControlSize.small;
        number-changed(row, column, value) => { EditTableAdapter.commit(row, column, value); }
    }
    Rectangle { horizontal-stretch: 0; }
}
