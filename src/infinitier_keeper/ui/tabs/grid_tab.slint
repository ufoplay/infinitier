// The Effects / Journal Entries tabs: a wide read-only table. Its columns
// are wider than the tab, so the rows scroll sideways and the header
// follows them.

import { Label, Table, TableCell, TableColumn, Theme, Tone } from "@themekit";

export global GridAdapter {
    in property <[TableColumn]> columns;
    in property <[[TableCell]]> rows;
    // Shown instead of the table when it has no rows ("" for none).
    in property <string> empty-text;
}

export component GridTab inherits VerticalLayout {
    spacing: Theme.spacing.xs;

    if GridAdapter.rows.length == 0 && GridAdapter.empty-text != "": Label {
        text: GridAdapter.empty-text;
        tone: Tone.muted;
    }
    Table {
        columns: GridAdapter.columns;
        rows: GridAdapter.rows;
    }
}
