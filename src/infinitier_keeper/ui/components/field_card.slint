// A titled card of character fields — the building block of the card tabs
// (Abilities, Characteristics, Resistances, …): each row a label, an
// optional "(effective: …)" hint, and an editor or a read-only value.

import { Card, Checkbox, ControlSize, Icons, Label, NumberField, Select, TextField, TextRole, Theme, Tone, TooltipText } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

// One editable / read-only row inside a card. `id` is the index into the
// active tab's field table, routed back on commit; `-1` marks a derived
// read-only row. `is-attacks` swaps the text input for the Attacks
// dropdown; `is-select` for a dropdown of `options`, `option-index` the
// current one, which commits the index picked; `is-check` renders a
// checkbox (label + `checked`); `numeric` edits the value with a number
// field (drag or type) from `minimum` to `maximum`, committing each change.
// A row with a `tooltip` explains itself on hover (its checkbox, or its
// label), and shows an info icon that says so.
export struct FieldRow {
    id: int,
    label: string,
    value: string,
    bonus: string,
    editable: bool,
    is-attacks: bool,
    is-select: bool,
    options: [string],
    option-index: int,
    is-check: bool,
    checked: bool,
    numeric: bool,
    minimum: int,
    maximum: int,
    tooltip: string,
}

// One titled card (e.g. "Ability scores") holding a set of rows, assigned
// to a display column (0..2) of the three-column grid. With a `tooltip`,
// its title explains the card on hover, with an info icon after it.
export struct FieldCard {
    title: string,
    column: int,
    rows: [FieldRow],
    tooltip: string,
}

// The info icon that says a title or a checkbox explains itself on hover;
// hovering it explains too.
component InfoIcon inherits VerticalLayout {
    in property <string> tooltip;

    alignment: center;
    Image {
        source: Icons.info;
        colorize: Theme.palette.text-muted;
        width: Theme.sizes.icon;
        height: Theme.sizes.icon;
        accessible-role: image;
        accessible-label: root.tooltip;
        Tooltip { TooltipText { text: root.tooltip; } }
    }
}

export component FieldCardView inherits Card {
    in property <FieldCard> card;
    in property <[string]> attacks-options;
    in property <int> attacks-index;
    callback commit-field(int /* id */, string /* value */);
    callback commit-attacks(int /* option index */);

    // Tighter than a default Card: three columns of label + input share the
    // panel, and long labels should elide as little as possible.
    content-padding: Theme.spacing.md;
    content-spacing: Theme.spacing.sm;

    HorizontalLayout {
        alignment: start;
        spacing: Theme.spacing.xs;
        Label {
            text: root.card.title;
            role: TextRole.heading;
            if root.card.tooltip != "": Tooltip { TooltipText { text: root.card.tooltip; } }
        }
        if root.card.tooltip != "": InfoIcon { tooltip: root.card.tooltip; }
    }
    for row in root.card.rows: HorizontalLayout {
        spacing: Theme.spacing.sm;

        // Checkbox row: the label lives in the box. Editable (commits
        // "1"/"0") when the row carries a real id; read-only (disabled) for
        // derived rows. Its info icon, if any, follows the label.
        if row.is-check: HorizontalLayout {
            alignment: start;
            spacing: Theme.spacing.xs;
            Checkbox {
                text: row.label;
                checked: row.checked;
                enabled: row.id >= 0;
                toggled => {
                    if (row.id >= 0) {
                        root.commit-field(row.id, row.checked ? "0" : "1");
                    }
                }
                if row.tooltip != "": Tooltip { TooltipText { text: row.tooltip; } }
            }
            if row.tooltip != "": InfoIcon { tooltip: row.tooltip; }
        }

        // Everything else: label + optional bonus + editor / value.
        if !row.is-check: HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing.sm;
            // The label flexes and elides, so the editor on the right is never
            // pushed off the column edge.
            if row.tooltip == "": Label {
                text: row.label;
                horizontal-stretch: 1;
                min-width: Metrics.field-label-min-width;
                overflow: elide;
            }
            // With its info icon after it, which stays in view.
            if row.tooltip != "": HorizontalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: Theme.spacing.xs;
                Label {
                    text: row.label;
                    min-width: Metrics.field-label-min-width;
                    overflow: elide;
                    Tooltip { TooltipText { text: row.tooltip; } }
                }
                InfoIcon { tooltip: row.tooltip; }
            }

            if row.bonus != "": Label {
                text: row.bonus;
                role: TextRole.caption;
                tone: Tone.muted;
            }

            if row.is-attacks: Select {
                width: Metrics.field-input-width;
                size: ControlSize.small;
                // A number, centred like those above and below it.
                horizontal-alignment: TextHorizontalAlignment.center;
                options: root.attacks-options;
                current-index: root.attacks-index;
                selected(index) => { root.commit-attacks(index); }
            }

            if row.is-select: Select {
                width: Metrics.field-select-width;
                size: ControlSize.small;
                options: row.options;
                current-index: row.option-index;
                selected(index) => { root.commit-field(row.id, index); }
            }

            if row.editable && row.numeric && !row.is-attacks: NumberField {
                width: Metrics.field-input-width;
                size: ControlSize.small;
                value: row.value.to-float();
                minimum: row.minimum;
                maximum: row.maximum;
                changed(value) => { root.commit-field(row.id, value); }
            }

            if row.editable && !row.numeric && !row.is-attacks: TextField {
                // The committed value, shown again once the edit is done:
                // the row updates in place, and the commit may clamp it.
                property <string> committed: row.value;
                changed committed => {
                    if (!self.has-focus) {
                        self.text = self.committed;
                    }
                }

                width: Metrics.field-input-width;
                size: ControlSize.small;
                // Centred, like the number fields among which it sits.
                horizontal-alignment: TextHorizontalAlignment.right;
                text: row.value;
                // Commit on Enter and on focus loss (clamp-on-blur).
                accepted(t) => {
                    root.commit-field(row.id, t);
                    self.text = self.committed;
                }
                changed has-focus => {
                    if (!self.has-focus) {
                        root.commit-field(row.id, self.text);
                        self.text = self.committed;
                    }
                }
            }

            if !row.editable && !row.is-attacks && !row.is-select: Label {
                width: Metrics.field-input-width;
                text: row.value;
                font-weight: Theme.typography.strong-weight;
                horizontal-alignment: right;
            }
        }
    }
}
