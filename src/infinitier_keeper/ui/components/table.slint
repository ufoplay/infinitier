// The keeper's tables: a header row over a `ListView` of striped `ListItem`s.
// Every table builds its header from these two, so they all look alike.

import { Label, TextRole, Theme, Tone } from "@themekit";

// A column's title, over the rows' cells.
export component ColumnHeader inherits Label {
    role: TextRole.caption;
    tone: Tone.muted;
    overflow: elide;
}

// The header row: padded like the rows, and on the right like the list's
// scroll indicator, so header cells sized like the rows' cells line up with
// them.
export component TableHeader inherits HorizontalLayout {
    padding-left: Theme.spacing.md;
    padding-right: Theme.spacing.md + Theme.sizes.scrollbar-width + Theme.spacing.xs;
    spacing: Theme.spacing.sm;
}
