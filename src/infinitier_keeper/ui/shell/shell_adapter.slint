// The window-wide state: what's loaded, the theme, the header's status and
// its actions.

// A notice of what an action did, shown as a toast. Each has its own `id`:
// a new one is a new toast, with its own time to show.
export struct Notice {
    id: int,
    title: string,
    text: string,
    // It didn't happen as asked.
    warning: bool,
}

export global ShellAdapter {
    // "Infinitier Keeper {version}", then " - {game}" once one is loaded.
    in property <string> title: "Infinitier Keeper";
    // What's open: a game (else "No game loaded") and a save (else "No save
    // loaded"); gates the header buttons.
    in property <bool> has-game;
    in property <bool> has-save;
    in property <bool> dark-theme;
    // One-line feedback, e.g. where a save was written.
    in property <string> status;
    // The notice to show, if any (at most one).
    in property <[Notice]> notices;
    // Notice `id` timed out or was closed.
    callback dismiss-notice(int /* id */);
    callback load-clicked();
    callback save-clicked();
    callback settings-clicked();
    callback theme-toggle();
}
