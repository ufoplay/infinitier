// The header bar: Load / Save, the browser toggles, the status line, the
// theme toggle and Settings.

import { Button, ButtonKind, Icons, Label, TextRole, Theme, Tone, VerticalDivider } from "@themekit";
import { BrowserKind, BrowsersAdapter } from "../browser/browser.slint";
import { ShellAdapter } from "shell_adapter.slint";

export component HeaderBar inherits HorizontalLayout {
    spacing: Theme.spacing.sm;
    Button {
        text: "Load";
        icon: Icons.open;
        enabled: ShellAdapter.has-game;
        clicked => { ShellAdapter.load-clicked(); }
    }
    Button {
        text: "Save";
        icon: Icons.save;
        enabled: ShellAdapter.has-save;
        clicked => { ShellAdapter.save-clicked(); }
    }
    VerticalDivider { }
    Button {
        text: "Items";
        icon: Icons.inventory;
        enabled: ShellAdapter.has-game;
        clicked => {
            BrowsersAdapter.front = BrowserKind.items;
            BrowsersAdapter.toggle(BrowserKind.items);
        }
    }
    Button {
        text: "Spells";
        icon: Icons.magic;
        enabled: ShellAdapter.has-game;
        clicked => {
            BrowsersAdapter.front = BrowserKind.spells;
            BrowsersAdapter.toggle(BrowserKind.spells);
        }
    }
    // Takes only the space left over, so it never squeezes the buttons.
    Label {
        text: ShellAdapter.status;
        role: TextRole.caption;
        tone: Tone.muted;
        horizontal-stretch: 1;
        preferred-width: 0px;
        horizontal-alignment: right;
        overflow: elide;
    }
    // Labelled with the theme it switches to.
    Button {
        text: ShellAdapter.dark-theme ? "Light" : "Dark";
        icon: Icons.contrast;
        kind: ButtonKind.ghost;
        clicked => { ShellAdapter.theme-toggle(); }
    }
    Button {
        text: "Settings";
        kind: ButtonKind.ghost;
        clicked => { ShellAdapter.settings-clicked(); }
    }
}
