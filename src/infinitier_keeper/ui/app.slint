// The Infinitier Keeper's main window, built on
// slint-themekit (`@themekit`): widgets and design values come from its
// components and `Theme` tokens (see THEMEKIT_MIGRATION.md).
//
// The UI is split like Slint's demo apps:
//   components/ — the keeper's own widgets (themekit-based), stateless
//   shell/      — the window's chrome: header, save tabs, party, tab strip
//   tabs/       — the character tabs' pages
//   browser/    — the floating Item / Spell Browser windows
//   dialogs/    — the modal dialogs
//   themes/     — the keeper's own layout values (`Metrics`)
// Each part reads and calls its `*Adapter` global, which the Rust side
// fills and handles; this file only composes the parts.

import { Divider, Icons, TableCell, TableCellKind, TableColumn, Theme, ThemePresets, Toast, ToastStack, Tone } from "@themekit";
import { Metrics } from "themes/metrics.slint";
import { FieldCard, FieldRow } from "components/components.slint";
import {
    CharacterAdapter,
    CharacterContent,
    CharacterPanel,
    EmptyState,
    HeaderBar,
    Notice,
    PartyAdapter,
    PartyList,
    PartyMember,
    SaveTabsAdapter,
    SaveTabStrip,
    ShellAdapter,
} from "shell/shell.slint";
import {
    AppearanceAdapter,
    CardsAdapter,
    ColorSwatch,
    EditTableAdapter,
    EffectsAdapter,
    GridAdapter,
    InventoryAdapter,
    SpellsAdapter,
    VariablesAdapter,
} from "tabs/tabs.slint";
import { BrowserKind, BrowserLayer, BrowsersAdapter, BrowserState, TypeFilter } from "browser/browser.slint";
import {
    DeleteSaveDialog,
    EffectDialog,
    EffectDialogAdapter,
    FormFolder,
    KitFeaturesAdapter,
    KitFeaturesDialog,
    VariableDialog,
    VariableDialogAdapter,
    LoadAdapter,
    LoadDialog,
    LoadingAdapter,
    LoadingOverlay,
    SaveAdapter,
    SaveDialog,
    SettingsAdapter,
    SettingsDialog,
} from "dialogs/dialogs.slint";

// For the Rust side.
export {
    ShellAdapter,
    Notice,
    SaveTabsAdapter,
    PartyAdapter,
    PartyMember,
    CharacterAdapter,
    CharacterContent,
    CardsAdapter,
    FieldCard,
    FieldRow,
    EditTableAdapter,
    VariablesAdapter,
    GridAdapter,
    AppearanceAdapter,
    ColorSwatch,
    InventoryAdapter,
    SpellsAdapter,
    EffectsAdapter,
    EffectDialogAdapter,
    KitFeaturesAdapter,
    VariableDialogAdapter,
    BrowsersAdapter,
    BrowserKind,
    BrowserState,
    TypeFilter,
    SettingsAdapter,
    FormFolder,
    LoadAdapter,
    SaveAdapter,
    LoadingAdapter,
    // The tables' cells and columns, the delete icon and the layout values
    // the Rust side builds them with.
    TableCell,
    TableCellKind,
    TableColumn,
    Icons,
    Metrics,
}

export component AppWindow inherits Window {
    title: ShellAdapter.title;
    background: Theme.palette.background;
    preferred-width: Metrics.window-width;
    preferred-height: Metrics.window-height;
    min-width: Metrics.window-min-width;
    min-height: Metrics.window-min-height;

    // The colour theme.
    property <bool> dark-theme: ShellAdapter.dark-theme;
    changed dark-theme => { root.apply-theme(); }
    init => { root.apply-theme(); }

    function apply-theme() {
        Theme.current = root.dark-theme ? ThemePresets.dark : ThemePresets.light;
    }


    // Scroll browser `kind`'s list so `row` is in view. (A global's callback
    // can't be implemented in .slint, so the Rust side calls this instead.)
    public function browser-scroll-to(kind: BrowserKind, row: int) {
        browsers.scroll-to(kind, row);
    }

    // Under everything: a click on nothing in particular (a card's
    // background, a label, empty space) takes the keyboard focus here, so a
    // field being edited loses it and commits, as when a control is clicked
    // (the themekit's controls take it themselves).
    FocusScope {
        width: root.width;
        height: root.height;
        focus-on-tab-navigation: false;
    }

    VerticalLayout {
        padding: Theme.spacing.md;
        spacing: Theme.spacing.sm;
        HeaderBar { }
        if SaveTabsAdapter.names.length > 0: SaveTabStrip { }
        // Sets the open saves apart from the page below.
        if SaveTabsAdapter.names.length > 0: Divider { }
        if !ShellAdapter.has-save: EmptyState { vertical-stretch: 1; }
        if ShellAdapter.has-save: HorizontalLayout {
            spacing: Theme.spacing.sm;
            PartyList { }
            CharacterPanel { horizontal-stretch: 1; }
        }
    }

    // Over the editor: the floating browsers, then the modal dialogs, then
    // the loading overlay (covering everything, an open dialog included).
    browsers := BrowserLayer {
        width: root.width;
        height: root.height;
    }
    if EffectDialogAdapter.open: EffectDialog {
        width: root.width;
        height: root.height;
    }
    if KitFeaturesAdapter.open: KitFeaturesDialog {
        width: root.width;
        height: root.height;
    }
    if VariableDialogAdapter.open: VariableDialog {
        width: root.width;
        height: root.height;
    }
    if LoadAdapter.open: LoadDialog {
        width: root.width;
        height: root.height;
    }
    if LoadAdapter.open && LoadAdapter.confirm-delete: DeleteSaveDialog {
        width: root.width;
        height: root.height;
    }
    if SaveAdapter.open: SaveDialog {
        width: root.width;
        height: root.height;
    }
    if SettingsAdapter.open: SettingsDialog {
        width: root.width;
        height: root.height;
    }
    // A notice of what an action did, over the editor and its dialogs; the
    // rest of the stack lets clicks through.
    ToastStack {
        width: root.width;
        height: root.height;
        for notice in ShellAdapter.notices: Toast {
            tone: notice.warning ? Tone.warning : Tone.success;
            title: notice.title;
            text: notice.text;
            close-label: "Dismiss";
            close-requested => { ShellAdapter.dismiss-notice(notice.id); }
        }
    }
    if LoadingAdapter.active: LoadingOverlay {
        width: root.width;
        height: root.height;
    }
}
