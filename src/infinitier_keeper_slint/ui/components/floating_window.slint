// A non-modal window floating over the editor: dragged by its title bar
// (kept inside the area it floats over), resized from its bottom-right
// grip, closed by its ×. Pressing anywhere on it asks to `raise` it over
// its siblings. Its children fill the area below the title bar.

import { Button, ButtonKind, Icons, Label, ResizeGrip, Shadow, TextRole, Theme } from "@themekit";

export component FloatingWindow inherits Rectangle {
    in property <string> title;
    // The area the window is kept inside while dragged / resized.
    in property <length> area-width;
    in property <length> area-height;
    // The smallest size the grip resizes the window to (0: no minimum).
    in property <length> min-window-width;
    in property <length> min-window-height;
    callback raise();
    callback close();

    // Floats over the editor, like a dialog: its shadow, then its face
    // (the root draws nothing itself, or it would cover the shadow).
    Shadow {
        width: root.width;
        height: root.height;
        radius: face.border-radius;
    }
    face := Rectangle {
        background: Theme.palette.surface;
        border-radius: Theme.radii.md;
        border-width: Theme.sizes.border-width;
        border-color: Theme.palette.border;
    }

    // Clicks on the window's empty areas stay on it (and bring it forward).
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.raise();
            }
        }
    }

    VerticalLayout {
        // Title bar: drag to move, × to close.
        Rectangle {
            background: Theme.palette.surface-variant;
            border-top-left-radius: face.border-radius;
            border-top-right-radius: face.border-radius;
            TouchArea {
                mouse-cursor: move;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.raise();
                    }
                }
                moved => {
                    root.x = max(0px, min(root.area-width - root.width, root.x + self.mouse-x - self.pressed-x));
                    root.y = max(0px, min(root.area-height - root.height, root.y + self.mouse-y - self.pressed-y));
                }
            }
            HorizontalLayout {
                padding-left: Theme.spacing.md;
                Label {
                    text: root.title;
                    role: TextRole.heading;
                    horizontal-stretch: 1;
                }
                Button {
                    icon: Icons.close;
                    kind: ButtonKind.ghost;
                    accessible-label: "Close " + root.title;
                    clicked => { root.close(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            @children
        }
    }

    ResizeGrip {
        x: root.width - self.width;
        y: root.height - self.height;
        accessible-label: "Resize " + root.title;
        dragged(dx, dy) => {
            root.width = max(root.min-window-width, min(root.area-width - root.x, root.width + dx));
            root.height = max(root.min-window-height, min(root.area-height - root.y, root.height + dy));
        }
    }
}
