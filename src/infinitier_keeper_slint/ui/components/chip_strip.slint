// A horizontally scrollable strip of chips, one per label, the current one
// highlighted: the open-saves tabs (closable), the character tabs and the
// Spells tab's books.

import { Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component ChipStrip inherits ScrollView {
    in property <[string]> labels;
    in property <int> current: -1;
    // Give each chip a × that requests `close`.
    in property <bool> closable;
    callback select(int);
    callback close(int);

    height: 40px;
    content-height: 36px;
    HorizontalLayout {
        alignment: start;
        spacing: 4px;
        for label[i] in root.labels: Rectangle {
            border-radius: 4px;
            background: i == root.current ? Palette.accent-background : Palette.alternate-background;
            // Behind: the whole chip selects. On top: the × closes.
            TouchArea {
                clicked => { root.select(i); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: root.closable ? 6px : 10px;
                spacing: 6px;
                // Full width (no eliding): the strip scrolls instead.
                Text {
                    text: label;
                    vertical-alignment: center;
                    color: i == root.current ? Palette.accent-foreground : Palette.foreground;
                }
                if root.closable: Rectangle {
                    width: 16px;
                    Text {
                        text: "×";
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        color: i == root.current ? Palette.accent-foreground : Theme.muted;
                    }
                    TouchArea {
                        clicked => { root.close(i); }
                    }
                }
            }
        }
    }
}
