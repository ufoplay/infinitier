// The building blocks of the keeper's lists: column headers, cell text, a
// selectable striped row and the list's frame.

import { Palette } from "std-widgets.slint";

// A column header.
export component HeaderCell inherits Text {
    font-weight: 700;
    color: Palette.foreground;
    vertical-alignment: center;
    overflow: elide;
}

// A cell's text, in the accent colour on a selected row.
export component RowText inherits Text {
    in property <bool> selected;
    color: root.selected ? Palette.accent-foreground : Palette.foreground;
    vertical-alignment: center;
    overflow: elide;
}

// A selectable list row: striped background, accent colour when selected.
// Its children are the cells, laid out horizontally. `mouse-x` / `mouse-y`
// locate the last click inside the row.
export component SelectableRow inherits Rectangle {
    in property <int> index;
    in property <bool> selected;
    out property <length> mouse-x: touch.mouse-x;
    out property <length> mouse-y: touch.mouse-y;
    callback clicked();
    callback double-clicked();

    height: 30px;
    background: root.selected ? Palette.accent-background : (Math.mod(root.index, 2) == 1 ? Palette.alternate-background : transparent);
    touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        @children
    }
}

// A list's border. Place it after the list, so the striped rows don't paint
// over it.
export component ListFrame inherits Rectangle {
    border-width: 1px;
    border-color: Palette.border;
}
