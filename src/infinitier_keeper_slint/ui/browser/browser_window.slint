// The Item / Spell Browser window: every item or spell of the game,
// filtered by free text and per type, with the selected entry's icon and
// description above an Add button. A FloatingWindow, so the editor stays
// usable behind it.

import { Button, Checkbox, Label, ListItem, ListView, Menu, MenuItem, ScrollArea, TextField, TextRole, Theme, Tone } from "@themekit";
import { ColumnHeader, FloatingWindow, TableHeader } from "../components/components.slint";
import { Metrics } from "../themes/metrics.slint";

// One row of the list. `level` / `script` are empty for items.
export struct BrowserRow {
    resref: string,
    name: string,
    category: string,
    level: string,
    script: string,
}

// One type-filter checkbox.
export struct TypeFilter {
    name: string,
    shown: bool,
}

// The rest of what a browser window shows.
export struct BrowserState {
    open: bool,
    // "Items: N" / "Spells: N" (the filtered count).
    count: string,
    // The selected entry's list row, -1 when it's filtered out / none.
    selected-row: int,
    has-selection: bool,
    icon: image,
    description: string,
    add-enabled: bool,
    add-label: string,
    // IWD2 spells: Add opens a menu of the spellbooks (`placements`) the
    // spell can go into.
    book-menu: bool,
    placements: [string],
}

export component BrowserWindow inherits FloatingWindow {
    // Spells add the Lvl and Script Name columns.
    in property <bool> spell-columns;
    in property <string> search-hint;
    in property <string> select-hint;
    in property <BrowserState> state;
    in property <[BrowserRow]> rows;
    in property <[TypeFilter]> types;
    // The search box's text (the user's draft, reset from outside).
    in-out property <string> text;
    in property <bool> all-types: true;
    callback search(string);
    callback select(string /* resref */);
    callback step(int /* -1 up, 1 down */);
    callback add(int /* placement, -1 for a plain add */);
    callback set-all-types(bool);
    callback set-type(string, bool);

    // Scroll the list so `row` is in view, centring it when it was off-screen.
    public function scroll-to(row: int) {
        if (row * Metrics.browser-row-height < -list.content-y || (row + 1) * Metrics.browser-row-height > -list.content-y + list.visible-height) {
            list.content-y = max(min(0px, list.visible-height - root.rows.length * Metrics.browser-row-height), min(0px, list.visible-height / 2 - (row + 0.5) * Metrics.browser-row-height));
        }
    }

    // Add the selected entry — through the spellbook menu, opened at the
    // window point (`x`, `y`), when there's a book to pick.
    function request-add(x: length, y: length) {
        if (!root.state.add-enabled) {
            return;
        }
        if (root.state.book-menu) {
            root.menu-x = x;
            root.menu-y = y;
            book-menu.show();
        } else {
            root.add(-1);
        }
    }

    property <length> menu-x;
    property <length> menu-y;

    visible: root.state.open;
    min-window-width: Metrics.browser-min-width;
    min-window-height: Metrics.browser-min-height;

    VerticalLayout {
        // The list, and the filters on its right.
        HorizontalLayout {
            vertical-stretch: 1;
            padding: Theme.spacing.sm;
            spacing: Theme.spacing.sm;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing.xs;
                TableHeader {
                    ColumnHeader { text: "Type"; width: Metrics.browser-type-column; }
                    if root.spell-columns: ColumnHeader { text: "Lvl"; width: Metrics.browser-level-column; }
                    ColumnHeader { text: "Name"; horizontal-stretch: 2; preferred-width: 0px; }
                    ColumnHeader { text: "Resource"; width: Metrics.browser-resource-column; }
                    if root.spell-columns: ColumnHeader { text: "Script Name"; horizontal-stretch: 1; preferred-width: 0px; }
                }
                Rectangle {
                    vertical-stretch: 1;
                    // Up / Down move the selection while the list has focus.
                    keys := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.UpArrow) {
                                root.step(-1);
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                root.step(1);
                                return accept;
                            }
                            return reject;
                        }
                        list := ListView {
                            for row[i] in root.rows: ListItem {
                                height: Metrics.browser-row-height;
                                index: i;
                                selected: i == root.state.selected-row;
                                clicked => {
                                    root.raise();
                                    keys.focus();
                                    root.select(row.resref);
                                }
                                double-clicked => {
                                    root.request-add(self.absolute-position.x - root.absolute-position.x + self.pointer-x, self.absolute-position.y - root.absolute-position.y + self.pointer-y);
                                }
                                Label { text: row.category; width: Metrics.browser-type-column; overflow: elide; }
                                if root.spell-columns: Label { text: row.level; width: Metrics.browser-level-column; }
                                Label { text: row.name; horizontal-stretch: 2; preferred-width: 0px; overflow: elide; }
                                Label { text: row.resref; width: Metrics.browser-resource-column; overflow: elide; }
                                if root.spell-columns: Label { text: row.script; horizontal-stretch: 1; preferred-width: 0px; overflow: elide; }
                            }
                        }
                    }
                    // The list's frame, drawn over the rows' stripes.
                    Rectangle {
                        border-width: Theme.sizes.border-width;
                        border-color: Theme.palette.border;
                    }
                }
            }

            VerticalLayout {
                width: Metrics.browser-filters-width;
                spacing: Theme.spacing.xs;
                Label { text: root.state.count; }
                Label { text: "Search"; role: TextRole.caption; tone: Tone.muted; }
                TextField {
                    text <=> root.text;
                    placeholder: root.search-hint;
                    edited(t) => {
                        root.raise();
                        root.search(t);
                    }
                }
                Checkbox {
                    text: "Types";
                    checked: root.all-types;
                    toggled => {
                        root.raise();
                        root.set-all-types(!root.all-types);
                    }
                }
                ScrollArea {
                    for t in root.types: HorizontalLayout {
                        padding-left: Theme.spacing.lg;
                        Checkbox {
                            text: t.name;
                            checked: t.shown;
                            toggled => {
                                root.raise();
                                root.set-type(t.name, !t.shown);
                            }
                        }
                    }
                }
            }
        }

        // The Add button, then the selected entry's icon + description.
        VerticalLayout {
            height: max(Metrics.browser-detail-min-height, min(root.height * 0.38, Metrics.browser-detail-max-height));
            padding: Theme.spacing.sm;
            padding-top: 0px;
            spacing: Theme.spacing.sm;
            HorizontalLayout {
                alignment: start;
                Button {
                    text: root.state.add-label;
                    enabled: root.state.add-enabled;
                    clicked => {
                        root.raise();
                        root.request-add(self.absolute-position.x - root.absolute-position.x, self.absolute-position.y - root.absolute-position.y + self.height);
                    }
                }
            }
            if !root.state.has-selection: Label {
                text: root.select-hint;
                tone: Tone.muted;
                vertical-stretch: 1;
                vertical-alignment: top;
            }
            if root.state.has-selection: HorizontalLayout {
                vertical-stretch: 1;
                spacing: Theme.spacing.sm;
                if root.state.icon.width > 0: VerticalLayout {
                    alignment: start;
                    Image {
                        source: root.state.icon;
                        width: Metrics.browser-icon;
                        height: Metrics.browser-icon;
                        image-fit: contain;
                    }
                }
                ScrollArea {
                    Label {
                        text: root.state.description == "" ? "(no description)" : root.state.description;
                        tone: root.state.description == "" ? Tone.muted : Tone.neutral;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }
        }
    }

    // IWD2: the spellbooks to add the selected spell to. Positioned relative
    // to the window itself, not to the content area its children fill.
    book-menu := Menu {
        x: root.menu-x;
        y: root.menu-y;
        for label[i] in root.state.placements: MenuItem {
            text: label;
            clicked => { root.add(i); }
        }
    }
}
