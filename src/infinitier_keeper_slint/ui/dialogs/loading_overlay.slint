// Shown while a game loads: a spinner, and the whole UI blocked — clicks by
// the backdrop, keys by grabbing the focus.

import { Palette, Spinner } from "std-widgets.slint";
import { DialogTitle, ModalFrame } from "../components/components.slint";

export global LoadingAdapter {
    in property <bool> active;
    in property <string> text;
}

export component LoadingOverlay inherits ModalFrame {
    panel-width: 600px;
    panel-height: 120px;

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => { accept }
        key-released(event) => { accept }
    }
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        DialogTitle { text: "Loading game"; }
        HorizontalLayout {
            spacing: 12px;
            Spinner {
                indeterminate: true;
                width: 28px;
                height: 28px;
            }
            Text {
                text: LoadingAdapter.text;
                color: Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}
