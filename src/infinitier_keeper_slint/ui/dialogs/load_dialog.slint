// The Load dialog: the game's saves (newest first) with a screenshot +
// portrait preview, and the prompt confirming a save's deletion.

import { Button, ListView } from "std-widgets.slint";
import { DialogTitle, ErrorText, HeaderCell, ListFrame, ModalFrame, RowText, SelectableRow } from "../components/components.slint";
import { Theme } from "../theme.slint";
import { ConfirmDialog } from "confirm_dialog.slint";

// One row of the saves list.
export struct LoadRowUi {
    name: string,
    time: string,
}

export global LoadAdapter {
    in property <bool> open;
    in property <[LoadRowUi]> rows;
    in property <int> selected: -1;
    in property <image> screenshot;
    in property <[image]> portraits;
    in property <string> error;
    // The delete prompt is up, for the save named `delete-name`.
    in property <bool> confirm-delete;
    in property <string> delete-name;
    callback select(int /* row */);
    callback pick(int /* row, double-clicked */);
    callback load();
    callback cancel();
    callback delete();
    callback delete-confirm();
    callback delete-cancel();
}

export component LoadDialog inherits ModalFrame {
    panel-width: 820px;
    panel-height: 560px;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        DialogTitle { text: "Open Single Player Saved Game"; }
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    HeaderCell { text: "Game Name"; width: 220px; }
                    HeaderCell { text: "Time Saved"; horizontal-stretch: 1; }
                }
                Rectangle {
                    vertical-stretch: 1;
                    if LoadAdapter.rows.length == 0: Text {
                        text: "No saved games found.";
                        color: Theme.muted;
                    }
                    ListView {
                        for row[i] in LoadAdapter.rows: SelectableRow {
                            index: i;
                            selected: i == LoadAdapter.selected;
                            clicked => { LoadAdapter.select(i); }
                            double-clicked => { LoadAdapter.pick(i); }
                            RowText { text: row.name; width: 220px; selected: i == LoadAdapter.selected; }
                            RowText { text: row.time; horizontal-stretch: 1; selected: i == LoadAdapter.selected; }
                        }
                    }
                    ListFrame { }
                }
            }
            VerticalLayout {
                width: 220px;
                alignment: start;
                spacing: 8px;
                Image {
                    source: LoadAdapter.screenshot;
                    width: 220px;
                    height: 165px;
                    image-fit: contain;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 3px;
                    for portrait in LoadAdapter.portraits: Image {
                        source: portrait;
                        width: 30px;
                        height: 46px;
                        image-fit: contain;
                    }
                }
            }
        }
        if LoadAdapter.error != "": ErrorText { text: LoadAdapter.error; }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Delete";
                enabled: LoadAdapter.selected >= 0;
                clicked => { LoadAdapter.delete(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Cancel";
                clicked => { LoadAdapter.cancel(); }
            }
            Button {
                text: "Load";
                primary: true;
                enabled: LoadAdapter.selected >= 0;
                clicked => { LoadAdapter.load(); }
            }
        }
    }
}

// Confirms deleting the selected save from disk.
export component DeleteSaveDialog inherits ConfirmDialog {
    title: "Delete saved game";
    message: "Permanently delete \"" + LoadAdapter.delete-name + "\"? This removes the save folder from disk and cannot be undone.";
    confirm-label: "Delete";
    confirm => { LoadAdapter.delete-confirm(); }
    cancel => { LoadAdapter.delete-cancel(); }
}
