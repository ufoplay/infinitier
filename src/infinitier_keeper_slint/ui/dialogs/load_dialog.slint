// The Load dialog: the game's saves (newest first) with a screenshot +
// portrait preview, and the prompt confirming a save's deletion.

import { Button, ButtonKind, Dialog, Label, ListItem, ListView, TextRole, Theme, Tone } from "@themekit";
import { Metrics } from "../themes/metrics.slint";
import { ConfirmDialog } from "confirm_dialog.slint";

// One row of the saves list.
export struct LoadRowUi {
    name: string,
    time: string,
}

export global LoadAdapter {
    in property <bool> open;
    in property <[LoadRowUi]> rows;
    in property <int> selected: -1;
    in property <image> screenshot;
    in property <[image]> portraits;
    in property <string> error;
    // The delete prompt is up, for the save named `delete-name`.
    in property <bool> confirm-delete;
    in property <string> delete-name;
    callback select(int /* row */);
    callback pick(int /* row, double-clicked */);
    callback load();
    callback cancel();
    callback delete();
    callback delete-confirm();
    callback delete-cancel();
}

component ColumnHeader inherits Label {
    role: TextRole.caption;
    tone: Tone.muted;
}

export component LoadDialog inherits Dialog {
    title: "Open Single Player Saved Game";
    panel-width: Metrics.load-dialog-width;
    panel-height: Metrics.load-dialog-height;

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: Theme.spacing.md;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing.xs;
            HorizontalLayout {
                padding-left: Theme.spacing.md;
                padding-right: Theme.spacing.md;
                spacing: Theme.spacing.sm;
                ColumnHeader { text: "Game Name"; width: Metrics.load-name-column; }
                ColumnHeader { text: "Time Saved"; horizontal-stretch: 1; }
            }
            Rectangle {
                vertical-stretch: 1;
                if LoadAdapter.rows.length == 0: Label {
                    text: "No saved games found.";
                    tone: Tone.muted;
                }
                ListView {
                    for row[i] in LoadAdapter.rows: ListItem {
                        index: i;
                        selected: i == LoadAdapter.selected;
                        clicked => { LoadAdapter.select(i); }
                        double-clicked => { LoadAdapter.pick(i); }
                        Label { text: row.name; width: Metrics.load-name-column; overflow: elide; }
                        Label { text: row.time; horizontal-stretch: 1; overflow: elide; }
                    }
                }
                // The list's frame, drawn over the rows' stripes.
                Rectangle {
                    border-width: Theme.sizes.border-width;
                    border-color: Theme.palette.border;
                }
            }
        }
        VerticalLayout {
            width: Metrics.load-preview-width;
            alignment: start;
            spacing: Theme.spacing.sm;
            Image {
                source: LoadAdapter.screenshot;
                width: Metrics.load-preview-width;
                height: Metrics.load-preview-height;
                image-fit: contain;
            }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.spacing.xs;
                for portrait in LoadAdapter.portraits: Image {
                    source: portrait;
                    width: Metrics.load-portrait-width;
                    height: Metrics.load-portrait-height;
                    image-fit: contain;
                }
            }
        }
    }
    if LoadAdapter.error != "": Label {
        text: LoadAdapter.error;
        tone: Tone.danger;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.spacing.sm;
        Button {
            text: "Delete";
            kind: ButtonKind.danger;
            enabled: LoadAdapter.selected >= 0;
            clicked => { LoadAdapter.delete(); }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Cancel";
            kind: ButtonKind.secondary;
            clicked => { LoadAdapter.cancel(); }
        }
        Button {
            text: "Load";
            enabled: LoadAdapter.selected >= 0;
            clicked => { LoadAdapter.load(); }
        }
    }
}

// Confirms deleting the selected save from disk.
export component DeleteSaveDialog inherits ConfirmDialog {
    title: "Delete saved game";
    message: "Permanently delete \"" + LoadAdapter.delete-name + "\"? This removes the save folder from disk and cannot be undone.";
    confirm-label: "Delete";
    confirm => { LoadAdapter.delete-confirm(); }
    cancel => { LoadAdapter.delete-cancel(); }
}
