// The Save dialog: the edited save's new folder name.

import { Button, ButtonKind, Dialog, Label, TextField, TextRole, Theme, Tone } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

export global SaveAdapter {
    in property <bool> open;
    // Pre-filled when the dialog opens; then the user's to edit.
    in-out property <string> folder-name;
    in property <string> error;
    callback confirm(string /* folder name */);
    callback cancel();
}

export component SaveDialog inherits Dialog {
    title: "Save edited save game";
    panel-width: Metrics.save-dialog-width;

    Label {
        text: "Save the current save game (GAM, SAV, BMP, WMP) into a new sibling folder.";
        wrap: word-wrap;
    }
    Label { text: "Folder name"; role: TextRole.caption; tone: Tone.muted; }
    TextField {
        text <=> SaveAdapter.folder-name;
        accepted(t) => { SaveAdapter.confirm(t); }
    }
    if SaveAdapter.error != "": Label {
        text: SaveAdapter.error;
        tone: Tone.danger;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing.sm;
        Button {
            text: "Cancel";
            kind: ButtonKind.secondary;
            clicked => { SaveAdapter.cancel(); }
        }
        Button {
            text: "Save";
            clicked => { SaveAdapter.confirm(SaveAdapter.folder-name); }
        }
    }
}
