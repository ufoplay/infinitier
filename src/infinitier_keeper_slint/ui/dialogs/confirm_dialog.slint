// A yes / no prompt for a destructive action.

import { Button, ButtonKind, Dialog, Label, Theme } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

export component ConfirmDialog inherits Dialog {
    in property <string> message;
    in property <string> confirm-label: "Confirm";
    callback confirm();
    callback cancel();

    panel-width: Metrics.confirm-dialog-width;

    Label {
        text: root.message;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing.sm;
        Button {
            text: "Cancel";
            kind: ButtonKind.secondary;
            clicked => { root.cancel(); }
        }
        Button {
            text: root.confirm-label;
            kind: ButtonKind.danger;
            clicked => { root.confirm(); }
        }
    }
}
