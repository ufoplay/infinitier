// The Settings dialog: the configured games (select + close, or
// double-click, to load one) and a form to add a game.

import { Button, ButtonKind, Dialog, Label, ListItem, ListView, Select, TextField, TextRole, Theme, Tone } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

// One row of the games list.
export struct GameRowUi {
    type-label: string,
    game-path: string,
    save-path: string,
}

export global SettingsAdapter {
    in property <bool> open;
    in property <[GameRowUi]> rows;
    in property <int> selected: -1;
    // The settings file couldn't be read / written.
    in property <string> file-error;
    // The add form's or the last game load's error.
    in property <string> error;
    // The add form's game-type choices ("Autodetect", then each game).
    in property <[string]> game-types;
    in-out property <string> form-game-path;
    in-out property <string> form-save-path;
    in-out property <int> form-game-type: 0;
    callback select(int /* row */);
    callback pick(int /* row, double-clicked */);
    callback remove();
    callback add(string /* game path */, string /* save path */, int /* game type */);
    callback close();
}

component ColumnHeader inherits Label {
    role: TextRole.caption;
    tone: Tone.muted;
}

component FormLabel inherits Label {
    width: Metrics.settings-label-width;
}

export component SettingsDialog inherits Dialog {
    title: "Settings";
    panel-width: Metrics.settings-dialog-width;
    panel-height: Metrics.settings-dialog-height;

    if SettingsAdapter.file-error != "": Label {
        text: SettingsAdapter.file-error;
        tone: Tone.danger;
        wrap: word-wrap;
    }

    Label { text: "Games"; role: TextRole.heading; }
    VerticalLayout {
        vertical-stretch: 1;
        spacing: Theme.spacing.xs;
        HorizontalLayout {
            padding-left: Theme.spacing.md;
            padding-right: Theme.spacing.md;
            spacing: Theme.spacing.sm;
            ColumnHeader { text: "Game type"; width: Metrics.settings-type-column; }
            ColumnHeader { text: "Game path"; horizontal-stretch: 1; preferred-width: 0px; }
            ColumnHeader { text: "Savegame path"; horizontal-stretch: 1; preferred-width: 0px; }
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: Metrics.settings-list-min-height;
            if SettingsAdapter.rows.length == 0: Label {
                text: "No games configured yet — add one below.";
                tone: Tone.muted;
            }
            ListView {
                for row[i] in SettingsAdapter.rows: ListItem {
                    index: i;
                    selected: i == SettingsAdapter.selected;
                    clicked => { SettingsAdapter.select(i); }
                    double-clicked => { SettingsAdapter.pick(i); }
                    Label { text: row.type-label; width: Metrics.settings-type-column; overflow: elide; }
                    Label { text: row.game-path; horizontal-stretch: 1; preferred-width: 0px; overflow: elide; }
                    Label { text: row.save-path; horizontal-stretch: 1; preferred-width: 0px; overflow: elide; }
                }
            }
            // The list's frame, drawn over the rows' stripes.
            Rectangle {
                border-width: Theme.sizes.border-width;
                border-color: Theme.palette.border;
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: Theme.spacing.sm;
        Button {
            text: "Remove";
            kind: ButtonKind.danger;
            enabled: SettingsAdapter.selected >= 0;
            clicked => { SettingsAdapter.remove(); }
        }
        Label {
            text: "Select a game and close this dialog to load it.";
            tone: Tone.muted;
        }
    }

    Label { text: "Add a game"; role: TextRole.heading; }
    GridLayout {
        spacing: Theme.spacing.sm;
        Row {
            FormLabel { text: "Game path"; }
            TextField {
                text <=> SettingsAdapter.form-game-path;
                placeholder: "Folder containing CHITIN.KEY";
            }
        }
        Row {
            FormLabel { text: "Savegame path"; }
            TextField {
                text <=> SettingsAdapter.form-save-path;
                placeholder: "Optional — folder containing save/, if outside the game folder";
            }
        }
        Row {
            FormLabel { text: "Game type"; }
            Select {
                options: SettingsAdapter.game-types;
                current-index: SettingsAdapter.form-game-type;
                selected(index) => { SettingsAdapter.form-game-type = index; }
            }
        }
        Row {
            Rectangle { }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Add";
                    kind: ButtonKind.secondary;
                    clicked => {
                        SettingsAdapter.add(SettingsAdapter.form-game-path, SettingsAdapter.form-save-path, SettingsAdapter.form-game-type);
                    }
                }
            }
        }
    }
    if SettingsAdapter.error != "": Label {
        text: SettingsAdapter.error;
        tone: Tone.danger;
        wrap: word-wrap;
    }

    HorizontalLayout {
        alignment: end;
        Button {
            text: "Close";
            clicked => { SettingsAdapter.close(); }
        }
    }
}
