// The left rail: the active save's party, portrait and name each.

import { Label, ListItem, ListView, TextRole, Theme } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

export struct PartyMember {
    name: string,
    portrait: image,
}

export global PartyAdapter {
    in property <[PartyMember]> members;
    in-out property <int> selected;
    callback select(int);
}

export component PartyList inherits VerticalLayout {
    width: Metrics.party-width;
    spacing: Theme.spacing.sm;
    Label {
        text: "Party";
        role: TextRole.heading;
    }
    ListView {
        for member[i] in PartyAdapter.members: ListItem {
            selected: i == PartyAdapter.selected;
            clicked => {
                PartyAdapter.selected = i;
                PartyAdapter.select(i);
            }
            Image {
                width: Metrics.portrait-width;
                height: Metrics.portrait-height;
                source: member.portrait;
                image-fit: contain;
            }
            Label {
                text: member.name;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}
