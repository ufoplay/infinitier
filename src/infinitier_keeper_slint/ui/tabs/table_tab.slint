// The Local / Global Variables tabs: a read-only Name · Value table.

import { Label, ListItem, ListView, TextRole, Theme, Tone } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

export struct VarRow {
    name: string,
    value: string,
}

export global TableAdapter {
    in property <[VarRow]> rows;
}

export component TableTab inherits VerticalLayout {
    spacing: Theme.spacing.xs;
    HorizontalLayout {
        padding-left: Theme.spacing.md;
        spacing: Theme.spacing.sm;
        Label { text: "Name"; role: TextRole.caption; tone: Tone.muted; width: Metrics.variable-name-width; }
        Label { text: "Value"; role: TextRole.caption; tone: Tone.muted; }
    }
    ListView {
        for row[i] in TableAdapter.rows: ListItem {
            index: i;
            Label { text: row.name; width: Metrics.variable-name-width; overflow: elide; }
            Label { text: row.value; horizontal-stretch: 1; overflow: elide; }
        }
    }
}
