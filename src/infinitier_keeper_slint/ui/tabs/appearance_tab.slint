// The Appearance tab: the animation's name and the colour swatches. In a
// ScrollArea like the card tabs: the fixed-width swatch rows would
// otherwise cap the panel's (and so the window's) width.

import { Card, Label, ScrollArea, TextRole, Theme } from "@themekit";
import { Metrics } from "../themes/metrics.slint";

// One labelled colour slot and its pre-rendered gradient swatch.
export struct ColorSwatch {
    label: string,
    image: image,
}

export global AppearanceAdapter {
    in property <string> animation-name;
    in property <[ColorSwatch]> swatches;
}

export component AppearanceTab inherits ScrollArea {
    content-spacing: Theme.spacing.sm;
    HorizontalLayout {
        spacing: Theme.spacing.md;
        Label { text: "Appearance"; width: Metrics.appearance-label-width; }
        Label {
            text: AppearanceAdapter.animation-name;
            font-weight: Theme.typography.strong-weight;
        }
    }
    Card {
        content-spacing: Theme.spacing.sm;
        Label { text: "Colors"; role: TextRole.heading; }
        for swatch in AppearanceAdapter.swatches: HorizontalLayout {
            spacing: Theme.spacing.md;
            Label { text: swatch.label; width: Metrics.appearance-label-width; }
            Image {
                source: swatch.image;
                width: Metrics.swatch-size;
                height: Metrics.swatch-size;
                image-rendering: pixelated;
            }
        }
    }
}
