// The Effects / Journal Entries tabs: a wide read-only grid, scrollable both
// ways. The lists are short, so the rows aren't virtualised.

import { Label, ScrollArea, TextRole, Theme, Tone } from "@themekit";

// One grid row; `cells` line up with the adapter's headers / widths.
export struct GridRow {
    cells: [string],
}

export global GridAdapter {
    in property <[string]> headers;
    // Each column's width.
    in property <[length]> widths;
    in property <[GridRow]> rows;
    // Wrap long cells onto more lines (rows grow to fit) instead of eliding
    // them — the Journal Entries tab's full entry text.
    in property <bool> wrap;
}

export component GridTab inherits ScrollArea {
    content-spacing: Theme.spacing.xs;
    HorizontalLayout {
        spacing: Theme.spacing.md;
        for header[i] in GridAdapter.headers: Label {
            text: header;
            role: TextRole.caption;
            tone: Tone.muted;
            width: GridAdapter.widths[i];
        }
    }
    for row in GridAdapter.rows: HorizontalLayout {
        spacing: Theme.spacing.md;
        for cell[i] in row.cells: Label {
            text: cell;
            width: GridAdapter.widths[i];
            overflow: GridAdapter.wrap ? clip : elide;
            wrap: GridAdapter.wrap ? word-wrap : no-wrap;
            vertical-alignment: top;
        }
    }
}
