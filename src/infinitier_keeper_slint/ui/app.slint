// The Infinitier Keeper's main window (Slint edition). Kept deliberately
// plain: only std-widgets, coloured from their Palette so the dark / light
// theme applies everywhere.
//
// The UI is split like Slint's demo apps (and like the egui keeper's
// `components/`, `ui/` and `ui/tabs/`):
//   components/ — reusable widgets, unaware of the keeper's state
//   shell/      — the window's chrome: header, save tabs, party, tab strip
//   tabs/       — the character tabs' pages
//   browser/    — the floating Item / Spell Browser windows
//   dialogs/    — the modal dialogs
// Each part reads and calls its `*Adapter` global, which the Rust side
// fills and handles; this file only composes the parts.

import { HorizontalBox, Palette, VerticalBox } from "std-widgets.slint";
import { FieldCard, FieldRow } from "components/components.slint";
import {
    CharacterAdapter,
    CharacterContent,
    CharacterPanel,
    EmptyState,
    HeaderBar,
    PartyAdapter,
    PartyList,
    PartyMember,
    SaveTabsAdapter,
    SaveTabStrip,
    ShellAdapter,
} from "shell/shell.slint";
import {
    AppearanceAdapter,
    CardsAdapter,
    ColorSwatch,
    GridAdapter,
    GridRow,
    InventoryAdapter,
    InvRow,
    SpellRowUi,
    SpellsAdapter,
    TableAdapter,
    VarRow,
} from "tabs/tabs.slint";
import { BrowserKind, BrowserLayer, BrowserRow, BrowsersAdapter, BrowserState, TypeFilter } from "browser/browser.slint";
import {
    DeleteSaveDialog,
    GameRowUi,
    LoadAdapter,
    LoadDialog,
    LoadingAdapter,
    LoadingOverlay,
    LoadRowUi,
    SaveAdapter,
    SaveDialog,
    SettingsAdapter,
    SettingsDialog,
} from "dialogs/dialogs.slint";

// For the Rust side.
export {
    ShellAdapter,
    SaveTabsAdapter,
    PartyAdapter,
    PartyMember,
    CharacterAdapter,
    CharacterContent,
    CardsAdapter,
    FieldCard,
    FieldRow,
    TableAdapter,
    VarRow,
    GridAdapter,
    GridRow,
    AppearanceAdapter,
    ColorSwatch,
    InventoryAdapter,
    InvRow,
    SpellsAdapter,
    SpellRowUi,
    BrowsersAdapter,
    BrowserKind,
    BrowserRow,
    BrowserState,
    TypeFilter,
    SettingsAdapter,
    GameRowUi,
    LoadAdapter,
    LoadRowUi,
    SaveAdapter,
    LoadingAdapter,
}

export component AppWindow inherits Window {
    title: ShellAdapter.title;
    background: Palette.background;
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 520px;

    // The colour theme, applied to the std-widgets Palette.
    property <bool> dark-theme: ShellAdapter.dark-theme;
    changed dark-theme => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    init => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }

    // Scroll browser `kind`'s list so `row` is in view. (A global's callback
    // can't be implemented in .slint, so the Rust side calls this instead.)
    public function browser-scroll-to(kind: BrowserKind, row: int) {
        browsers.scroll-to(kind, row);
    }

    VerticalBox {
        padding: 8px;
        spacing: 8px;
        HeaderBar { }
        if SaveTabsAdapter.names.length > 0: SaveTabStrip { }
        if !ShellAdapter.has-save: EmptyState { vertical-stretch: 1; }
        if ShellAdapter.has-save: HorizontalBox {
            spacing: 8px;
            PartyList { }
            CharacterPanel { horizontal-stretch: 1; }
        }
    }

    // Over the editor: the floating browsers, then the modal dialogs, then
    // the loading overlay (covering everything, an open dialog included).
    browsers := BrowserLayer {
        width: root.width;
        height: root.height;
    }
    if LoadAdapter.open: LoadDialog {
        width: root.width;
        height: root.height;
    }
    if LoadAdapter.open && LoadAdapter.confirm-delete: DeleteSaveDialog {
        width: root.width;
        height: root.height;
    }
    if SaveAdapter.open: SaveDialog {
        width: root.width;
        height: root.height;
    }
    if SettingsAdapter.open: SettingsDialog {
        width: root.width;
        height: root.height;
    }
    if LoadingAdapter.active: LoadingOverlay {
        width: root.width;
        height: root.height;
    }
}
